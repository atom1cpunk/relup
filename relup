set -euo pipefail

TOOL_NAME="relup"
TOOL_VERSION="0.3.0"

CONF_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/${TOOL_NAME}"
APPS_DIR="${CONF_ROOT}/apps.d"
SETTINGS_FILE="${CONF_ROOT}/settings.conf"

# Defaults; overridden by settings.conf
DOWNLOAD_DIR="/tmp"
CLEAR_SCREEN="yes"
BIN_DIR="$HOME/.local/bin"      # where single-file programs (AppImages, binaries, scripts) are installed
CACHE="yes"                     # keep GitHub's answers between runs (ETag cache)
USE_GH_AUTH="no"                # reuse the GitHub CLI's login for API requests
SETTINGS_KEYS="DOWNLOAD_DIR CLEAR_SCREEN BIN_DIR CACHE USE_GH_AUTH"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/${TOOL_NAME}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/${TOOL_NAME}"
API_TOKEN=""
DRY_RUN=0

ASSUME_YES=0            # -y: answer yes to ordinary prompts
SKIP_UPDATE_CONFIRM=0   # set during "update all" after the batch was confirmed once
TMP_DIR=""

# ---------- output helpers ----------
if [[ -t 1 ]]; then
    C_RED=$'\e[31m'; C_GRN=$'\e[32m'; C_YEL=$'\e[33m'; C_BLD=$'\e[1m'; C_RST=$'\e[0m'
else
    C_RED=""; C_GRN=""; C_YEL=""; C_BLD=""; C_RST=""
fi
info() { printf '%s\n' "$*"; }
ok()   { printf '%s%s%s\n' "$C_GRN" "$*" "$C_RST"; }
warn() { printf '%s%s%s\n' "$C_YEL" "$*" "$C_RST" >&2; }
err()  { printf '%s%s%s\n' "$C_RED" "$*" "$C_RST" >&2; }

usage() {
    cat <<EOF
${TOOL_NAME} ${TOOL_VERSION} — update programs installed from GitHub releases

USAGE
  ${TOOL_NAME} [options] [command]

COMMANDS
  (none)                  Open the interactive menu
  add [URL|owner/repo]    Start tracking a program (guided)
  list                    List tracked programs and installed versions (offline)
  check                   Compare installed vs. latest version for every program
  update <id>             Update one program
  update --all            Update every program that has a newer release
  edit <id>               Edit a program's config in your editor
  remove <id>             Uninstall a program and/or stop tracking it
  config                  Edit ${TOOL_NAME}'s own settings
  help                    Show this help

OPTIONS
  -n, --dry-run           With 'update': show the file, size, checksum and the
                          command that would run, without downloading or installing
  -y, --yes               Answer yes to ordinary confirmation prompts
                          (uninstalling, replacing a config and installing an
                          unverified download always ask)
  -h, --help              Show this help
  -V, --version           Show the version

FILES
  ${APPS_DIR}/<id>.conf
                          one config file per tracked program
  ${SETTINGS_FILE}
                          ${TOOL_NAME} settings (download folder, install folder, cache, ...)
  ${CACHE_DIR}/
                          saved GitHub answers (safe to delete)
  ${STATE_DIR}/installed/
                          what ${TOOL_NAME} installed, for single-file programs

ENVIRONMENT
  GITHUB_TOKEN            Optional. Raises the GitHub API limit from 60 to
                          5000 requests per hour, and makes unchanged answers free.
                          (Or set USE_GH_AUTH=yes in the settings to reuse "gh" login.)
  VISUAL / EDITOR         Editor used by 'edit' and 'config'.

EXAMPLES
  ${TOOL_NAME} add https://github.com/brave/brave-browser/releases
  ${TOOL_NAME} check
  ${TOOL_NAME} update --all --dry-run
  ${TOOL_NAME} update --all
EOF
}

# ---------- prompts ----------
ANSWER=""
ask() {  # ask <prompt> [default]  -> sets ANSWER; Ctrl-D exits cleanly
    local prompt=$1 default=${2:-}
    if [[ -n $default ]]; then
        printf '%s [%s]: ' "$prompt" "$default" >&2
    else
        printf '%s: ' "$prompt" >&2
    fi
    read -r ANSWER || { echo >&2; exit 0; }
    ANSWER=${ANSWER:-$default}
}

_confirm() {  # _confirm <message> <default y|n>
    local reply hint="[y/N]"
    [[ $2 == y ]] && hint="[Y/n]"
    printf '%s %s ' "$1" "$hint" >&2
    # No input (Ctrl-D, or an unattended run with nothing on stdin) counts as "no". Exiting here
    # instead would end "update --all" halfway through and still report success.
    if ! read -r reply; then
        echo >&2
        warn "No answer (no input); taking that as no."
        return 1
    fi
    reply=${reply:-$2}
    [[ $reply =~ ^[Yy] ]]
}
confirm() {  # honours -y
    if [[ $ASSUME_YES -eq 1 ]]; then return 0; fi
    _confirm "$1" "${2:-n}"
}
confirm_strict() { _confirm "$1" "${2:-n}"; }  # ignores -y (destructive actions)

# ---------- setup ----------
check_deps() {
    local missing=() cmd
    for cmd in curl jq sha256sum; do
        command -v "$cmd" >/dev/null || missing+=("$cmd")
    done
    if ((${#missing[@]})); then
        err "Missing required tools: ${missing[*]}"
        exit 1
    fi
}

cleanup() {
    if [[ -n $TMP_DIR ]]; then rm -rf "$TMP_DIR"; fi
    TMP_DIR=""
    return 0
}
trap cleanup EXIT

write_default_settings() {
    cat > "$SETTINGS_FILE" <<EOF
# ${TOOL_NAME} settings
# Format: KEY=value   (one per line, no inline comments; lines starting with # are ignored)

# Folder where downloads are staged before installing.
# A temporary subfolder is created here and removed afterwards.
DOWNLOAD_DIR=/tmp

# Clear the screen before each menu and job (yes or no).
CLEAR_SCREEN=yes

# Where single-file programs (AppImages, executables, scripts) are installed.
BIN_DIR=~/.local/bin

# Remember GitHub's answers between runs, so unchanged data is cheap (yes or no).
CACHE=yes

# Reuse your GitHub CLI login ("gh auth login") for API requests (yes or no).
# Logged-in requests have a much higher rate limit, and unchanged answers cost nothing.
USE_GH_AUTH=no
EOF
}

init_config() {
    mkdir -p "$APPS_DIR"
    local f
    shopt -s nullglob
    for f in "$APPS_DIR"/*.conf; do
        [[ $(basename "$f" .conf) =~ ^[A-Za-z0-9._-]+$ ]] \
            || warn "Ignoring ${f}: program file names may only use letters, digits, '.', '-' and '_'."
    done
    shopt -u nullglob
    [[ -f $SETTINGS_FILE ]] || write_default_settings
    parse_conf "$SETTINGS_FILE" "$SETTINGS_KEYS"
    setup_api_token
    if cache_enabled && [[ -d $CACHE_DIR ]]; then
        find "$CACHE_DIR" -type f -mtime +30 -delete 2>/dev/null || true
    fi
}

is_yes() { case ${1,,} in yes|true|on|1) return 0 ;; esac; return 1; }
cache_enabled() { case ${CACHE,,} in no|false|off|0) return 1 ;; esac; return 0; }

setup_api_token() {  # GITHUB_TOKEN wins; otherwise optionally borrow the GitHub CLI's login
    API_TOKEN=${GITHUB_TOKEN:-}
    if [[ -z $API_TOKEN ]] && is_yes "$USE_GH_AUTH" && command -v gh >/dev/null; then
        API_TOKEN=$(gh auth token 2>/dev/null || true)
    fi
}

# ---------- config parsing ----------
# Config files are plain KEY='value' data, never executed as shell code.
# Only whitelisted keys are accepted.
parse_conf() {  # parse_conf <file> "<ALLOWED KEYS>"
    local file=$1 allowed=" $2 " line key val
    while IFS= read -r line || [[ -n $line ]]; do
        if [[ $line =~ ^[[:space:]]*(#.*)?$ ]]; then continue; fi
        if [[ $line =~ ^[[:space:]]*([A-Z_]+)[[:space:]]*=[[:space:]]*(.*)$ ]]; then
            key=${BASH_REMATCH[1]}
            val=${BASH_REMATCH[2]}
            val=${val%"${val##*[![:space:]]}"}          # trim trailing whitespace
            if [[ $val =~ ^\"(.*)\"$ ]]; then
                val=${BASH_REMATCH[1]}
            elif [[ $val =~ ^\'(.*)\'$ ]]; then
                val=${BASH_REMATCH[1]}
            fi
            if [[ $val == "~/"* ]]; then val="${HOME}/${val#"~/"}"; fi
            if [[ $allowed == *" $key "* ]]; then
                printf -v "$key" '%s' "$val"
            else
                warn "${file##*/}: ignoring unknown setting '${key}'"
            fi
        else
            warn "${file##*/}: cannot parse line: ${line}"
        fi
    done < "$file"
}

# ---------- tracked programs ----------
APP_KEYS="NAME SOURCE REPO TAG_PREFIX ASSET_REGEX INSTALL PKG VERIFY_CHECKSUM BIN_NAME DEST_DIR"

list_app_ids() {
    local f id
    shopt -s nullglob
    for f in "$APPS_DIR"/*.conf; do
        id=$(basename "$f" .conf)
        if [[ $id =~ ^[A-Za-z0-9._-]+$ ]]; then printf '%s\n' "$id"; fi
    done
    shopt -u nullglob
}

has_apps() { [[ -n $(list_app_ids) ]]; }

load_app() {
    local id=$1 file="${APPS_DIR}/$1.conf"
    if [[ ! $id =~ ^[A-Za-z0-9._-]+$ || ! -f $file ]]; then
        err "Unknown program: ${id}"
        return 1
    fi
    NAME="$id"; SOURCE="github"; REPO=""; TAG_PREFIX=""; ASSET_REGEX=""
    INSTALL="rpm"; PKG="$id"; VERIFY_CHECKSUM="auto"; BIN_NAME="$id"; DEST_DIR=""; APP_ID="$id"
    parse_conf "$file" "$APP_KEYS"

    local bad=""
    [[ $REPO =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]      || bad="REPO must look like owner/repo"
    [[ -n $ASSET_REGEX ]]                                 || bad="ASSET_REGEX is empty"
    [[ $PKG =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]]          || bad="PKG is missing or has invalid characters"
    [[ $INSTALL =~ ^[a-z0-9_]+$ ]] && declare -F "install_${INSTALL}" >/dev/null \
                                                          || bad="INSTALL '${INSTALL}' is not supported"
    declare -F "${SOURCE}_releases" >/dev/null 2>&1       || bad="SOURCE '${SOURCE}' is not supported"
    [[ $VERIFY_CHECKSUM =~ ^(auto|required|skip)$ ]]      || bad="VERIFY_CHECKSUM must be auto, required or skip"
    if [[ $INSTALL == binary ]]; then
        [[ $BIN_NAME =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]]  || bad="BIN_NAME is missing or has invalid characters"
        [[ -z $DEST_DIR || $DEST_DIR == /* ]]             || bad="DEST_DIR must be an absolute path"
    fi
    if [[ -n $bad ]]; then
        err "${id}: ${bad} (${file})"
        return 1
    fi
}

# ---------- GitHub ----------
cache_store() {  # cache_store <body-file> <etag-file> <body> <etag>; best effort, never fails the caller
    local cfile=$1 efile=$2 tmp
    mkdir -p -m 700 "$CACHE_DIR" 2>/dev/null || return 0
    rm -f "$efile"
    tmp=$(mktemp "${cfile}.XXXXXX" 2>/dev/null) || return 0
    if printf '%s' "$3" > "$tmp" && mv -f "$tmp" "$cfile"; then
        printf '%s\n' "$4" > "$efile" 2>/dev/null || true
    else
        rm -f "$tmp"
    fi
    return 0
}

# Asks GitHub for <path>. Answers are cached with their ETag, and later requests ask "has this
# changed?". An unchanged answer (304) is fast, and free of your rate limit when you are
# logged in (GITHUB_TOKEN or USE_GH_AUTH). Out of quota, the last saved answer is used.
gh_api() {  # gh_api <path> -> prints the JSON body
    local path=$1 out code hdrf key cfile="" efile="" etag="" rc=0 cached=0 cond=() auth=()
    if [[ -n $API_TOKEN ]]; then auth=(-H "Authorization: Bearer ${API_TOKEN}"); fi
    if cache_enabled; then
        key=$(printf '%s' "$path" | sha256sum | cut -c1-40)
        cfile="${CACHE_DIR}/${key}.json"; efile="${CACHE_DIR}/${key}.etag"
        if [[ -f $cfile && -f $efile ]]; then
            etag=$(<"$efile")
            if [[ -n $etag ]]; then cached=1; cond=(-H "If-None-Match: ${etag}"); fi
        fi
    fi
    hdrf=$(mktemp "${TMPDIR:-/tmp}/${TOOL_NAME}-hdr.XXXXXX") || hdrf=/dev/null
    out=$(curl -sSL "${auth[@]}" "${cond[@]}" -D "$hdrf" -H 'Accept: application/vnd.github+json' \
               -w $'\n%{http_code}' "https://api.github.com/${path}") || {
        if [[ $hdrf != /dev/null ]]; then rm -f "$hdrf"; fi
        err "Could not reach GitHub (network problem?)"
        return 1
    }
    code=${out##*$'\n'}
    out=${out%$'\n'*}
    case $code in
        200)
            printf '%s' "$out"
            if [[ -n $cfile ]]; then
                etag=$(awk 'tolower($1) == "etag:" { sub(/^[^:]*:[ \t]*/, ""); sub(/\r$/, ""); v = $0 } END { print v }' "$hdrf" 2>/dev/null || true)
                if [[ -n $etag ]]; then cache_store "$cfile" "$efile" "$out" "$etag"; fi
            fi ;;
        304)
            if [[ $cached -eq 1 ]]; then cat "$cfile"; else err "Unexpected 'not modified' reply from GitHub."; rc=1; fi ;;
        403|429)
            if [[ $cached -eq 1 ]]; then
                warn "GitHub's API limit was reached; using the last saved data for ${path%%\?*}."
                cat "$cfile"
            else
                err "GitHub refused the request (API rate limit? set GITHUB_TOKEN, or USE_GH_AUTH=yes if you use the gh CLI)"
                rc=1
            fi ;;
        404) err "Not found on GitHub: ${path%%\?*}"; rc=1 ;;
        *)   err "GitHub API returned HTTP ${code} for ${path%%\?*}"; rc=1 ;;
    esac
    if [[ $hdrf != /dev/null ]]; then rm -f "$hdrf"; fi
    return $rc
}

# Prints normalized releases: [{tag, draft, prerelease, date, assets:[{name,url,size,digest}]}]
# Other sources (e.g. GitLab) can be added later by providing <source>_releases with the same output.
github_releases() {  # github_releases <owner/repo> [page]
    local json page=${2:-1} query="per_page=100"
    if ((page > 1)); then query+="&page=${page}"; fi
    json=$(gh_api "repos/$1/releases?${query}") || return 1
    jq -c '[ .[] | {
                tag: .tag_name,
                draft: (.draft // false),
                prerelease: (.prerelease // false),
                date: (.published_at // ""),
                assets: [ .assets[] | {
                    name: .name,
                    url: .browser_download_url,
                    size: (.size // 0),
                    digest: (.digest // "") } ] } ]' <<< "$json"
}

get_releases() { "${SOURCE}_releases" "$@"; }

# Sets LATEST_* for the loaded app. Prints the matching release as JSON.
find_latest() {
    local releases result page count
    # Busy repos can bury a product's newest release past page 1, so look at up to 3 pages,
    # stopping as soon as a match is found or a page comes back short (no more releases).
    for page in 1 2 3; do
        releases=$(get_releases "$REPO" "$page") || return 1
        result=$(jq -c --arg p "$TAG_PREFIX" --arg re "$ASSET_REGEX" '
            [ .[]
              | select(.draft == false and .prerelease == false)
              | select(.tag | startswith($p))
              | . as $rel
              | ([ $rel.assets[] | select(.name | test($re)) ] | first) as $a
              | select($a != null)
              | { tag: $rel.tag,
                  version: ($rel.tag | ltrimstr($p) | ltrimstr("v")),
                  date: $rel.date,
                  asset: $a,
                  assets: $rel.assets }
            ] | first // empty' <<< "$releases") || {
            err "${NAME}: could not evaluate ASSET_REGEX (is it a valid regex?)"
            return 1
        }
        if [[ -n $result ]]; then printf '%s' "$result"; return 0; fi
        count=$(jq 'length' <<< "$releases") || count=0
        if ((count < 100)); then break; fi
    done
    err "${NAME}: no release found with a file matching ASSET_REGEX"
    return 1
}

LATEST_JSON=""; LATEST_VER=""; LATEST_TAG=""; LATEST_NAME=""; LATEST_URL=""; LATEST_DIGEST=""
LATEST_DATE=""; LATEST_SIZE=0
parse_latest() {
    local f=() d
    LATEST_JSON=$1
    mapfile -t f < <(jq -r '.version, .tag, .asset.name, .asset.url, .asset.digest, .date, .asset.size' <<< "$1")
    LATEST_VER=${f[0]}; LATEST_TAG=${f[1]}; LATEST_NAME=${f[2]##*/}; LATEST_URL=${f[3]}
    LATEST_DIGEST=${f[4]:-}; d=${f[5]:-}; LATEST_DATE=${d:0:10}; LATEST_SIZE=${f[6]:-0}
}

# ---------- install methods ----------
# A method <m> provides: installed_version_<m>, install_<m> <file> <installed_ver>, uninstall_<m>
installed_version_rpm() {
    local out
    if out=$(rpm -q --qf '%{VERSION}' "$PKG" 2>/dev/null); then
        printf '%s' "$out"
    else
        printf 'none'
    fi
}

install_rpm() {
    local file=$1 installed=$2
    if [[ $installed == none ]]; then
        sudo dnf install -y "$file"
    else
        sudo dnf upgrade -y "$file"
    fi
}

uninstall_rpm() { sudo dnf remove -y "$PKG"; }

# What each method would do, in words (used by --dry-run and the uninstall prompt)
install_command_rpm() {  # install_command_rpm <file-name> <installed-version>
    local verb=upgrade
    if [[ $2 == none ]]; then verb=install; fi
    printf 'sudo dnf %s -y %s/%s.XXXXXX/%s' "$verb" "$DOWNLOAD_DIR" "$TOOL_NAME" "$1"
}
uninstall_command_rpm() { printf 'sudo dnf remove -y %s' "$PKG"; }
describe_target_rpm() { printf 'package %s' "$PKG"; }

# ----- "binary": a single file (AppImage, static executable, script) copied into a folder.
# There is no package database for these, so what was installed is recorded in a small state file.
binary_dest() { printf '%s/%s' "${DEST_DIR:-$BIN_DIR}" "$BIN_NAME"; }
state_file() { printf '%s/installed/%s' "$STATE_DIR" "$APP_ID"; }

installed_version_binary() {
    local dest f v VERSION="" FILE="" INSTALLED_ON=""
    dest=$(binary_dest); f=$(state_file)
    if [[ ! -e $dest ]]; then printf 'none'; return 0; fi
    if [[ -f $f ]]; then
        parse_conf "$f" "VERSION FILE INSTALLED_ON"
        if [[ -n $VERSION && $FILE == "$dest" ]]; then printf '%s' "$VERSION"; return 0; fi
    fi
    if [[ $BIN_NAME == "$TOOL_NAME" ]]; then   # this tool can read its own version from the script, without running it
        v=$(sed -n 's/^TOOL_VERSION="\(.*\)"$/\1/p' "$dest" 2>/dev/null | head -n1) || v=""
        if [[ -n $v ]]; then printf '%s' "$v"; return 0; fi
    fi
    printf 'unknown'
}

installed_date_binary() {
    local dest f VERSION="" FILE="" INSTALLED_ON=""
    dest=$(binary_dest); f=$(state_file)
    [[ -e $dest ]] || return 1
    if [[ -f $f ]]; then
        parse_conf "$f" "VERSION FILE INSTALLED_ON"
        if [[ -n $INSTALLED_ON && $FILE == "$dest" ]]; then printf '%s' "$INSTALLED_ON"; return 0; fi
    fi
    date -r "$dest" +%F
}

looks_like_program() {  # an ELF binary (AppImages are ELF) or a script with a #! line
    local magic
    magic=$(head -c 4 "$1" | od -An -tx1 | tr -d ' \n')
    [[ $magic == 7f454c46 || ${magic:0:4} == 2321 ]]
}

record_install() {  # record_install <dest>
    local f; f=$(state_file)
    mkdir -p "${f%/*}" 2>/dev/null || return 0
    printf "# Written by %s; records the last install of this program.\nVERSION='%s'\nFILE='%s'\nINSTALLED_ON='%s'\n" \
        "$TOOL_NAME" "$(clean_value "$LATEST_VER")" "$(clean_value "$1")" "$(date +%F)" > "$f" 2>/dev/null || true
}

install_binary() {  # install_binary <downloaded-file> <installed-version>
    local file=$1 dir dest tmp sudo=()
    dir=${DEST_DIR:-$BIN_DIR}; dest="${dir}/${BIN_NAME}"; tmp="${dest}.${TOOL_NAME}-new"
    if ! looks_like_program "$file"; then
        err "${LATEST_NAME} doesn't look like a program (not an ELF binary, AppImage or script). It may be an archive; ${TOOL_NAME} only installs single-file programs."
        return 1
    fi
    mkdir -p "$dir" 2>/dev/null || true
    if [[ ! -w $dir ]]; then
        sudo=(sudo)
        info "${dir} isn't writable by you; using sudo."
        "${sudo[@]}" mkdir -p "$dir" || return 1
    fi
    # install beside the target, then rename: replaces a running program safely
    "${sudo[@]}" install -m 755 "$file" "$tmp" || return 1
    "${sudo[@]}" mv -f "$tmp" "$dest" || { "${sudo[@]}" rm -f "$tmp"; return 1; }
    record_install "$dest"
    case ":${PATH}:" in *":${dir}:"*) ;; *) warn "Note: ${dir} is not in your PATH." ;; esac
}

uninstall_binary() {
    local dest sudo=()
    dest=$(binary_dest)
    if [[ ! -w ${dest%/*} ]]; then sudo=(sudo); fi
    "${sudo[@]}" rm -f "$dest" || return 1
    rm -f "$(state_file)"
}

install_command_binary() {  # install_command_binary <file-name> <installed-version>
    local dir=${DEST_DIR:-$BIN_DIR} pre=""
    if [[ ! -w $dir ]]; then pre="sudo "; fi
    printf '%sinstall -m 755 <downloaded %s> %s' "$pre" "$1" "$(binary_dest)"
}
uninstall_command_binary() { printf 'rm %s' "$(binary_dest)"; }
describe_target_binary() { binary_dest; }

package_name_rpm() { rpm -qp --qf '%{NAME}' "$1" 2>/dev/null; }

installed_date_rpm() {
    local t
    t=$(rpm -q --qf '%{INSTALLTIME}' "$PKG" 2>/dev/null) || return 1
    [[ $t =~ ^[0-9]+$ ]] || return 1
    date -d "@${t}" +%F
}

# An rpm starts with its metadata, so the package name can be read from just the first
# part of the file instead of downloading all of it. Prints the name, or fails.
remote_package_name_rpm() {  # remote_package_name_rpm <url>
    local url=$1 tmp name n
    command -v rpm >/dev/null || return 1
    mkdir -p "$DOWNLOAD_DIR"
    tmp=$(mktemp -p "$DOWNLOAD_DIR" "${TOOL_NAME}-header.XXXXXX") || return 1
    for n in 524288 4194304; do
        if curl -fsSL -r "0-$((n - 1))" --max-filesize $((n * 2)) "$url" -o "$tmp" 2>/dev/null; then
            name=$(rpm -qp --nosignature --nodigest --qf '%{NAME}' "$tmp" 2>/dev/null) || name=""
            if [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]]; then
                rm -f "$tmp"; printf '%s' "$name"; return 0
            fi
        fi
    done
    rm -f "$tmp"
    return 1
}

set_conf_value() {  # set_conf_value <file> <KEY> <value>: rewrites that line, or appends it
    local file=$1 key=$2 val line found=0 tmp
    val=$(clean_value "$3")
    tmp=$(mktemp "${file}.XXXXXX") || return 1
    while IFS= read -r line || [[ -n $line ]]; do
        if [[ $line == "${key}="* ]]; then
            printf "%s='%s'\n" "$key" "$val"; found=1
        else
            printf '%s\n' "$line"
        fi
    done < "$file" > "$tmp"
    if [[ $found -eq 0 ]]; then printf "%s='%s'\n" "$key" "$val" >> "$tmp"; fi
    chmod --reference="$file" "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$file"
}

get_installed_version() { "installed_version_${INSTALL}"; }

get_installed_date() {  # date the package was installed or last upgraded, or "-"
    local d
    if declare -F "installed_date_${INSTALL}" >/dev/null && d=$("installed_date_${INSTALL}"); then
        printf '%s' "$d"
    else
        printf -- '-'
    fi
}

# ---------- status ----------
declare -A ST_INSTALLED ST_LATEST ST_STATE ST_JSON ST_RELEASED ST_ON
STATUS_FRESH=0

# rpm versions often carry build metadata the release tag lacks (1.19.0+65 vs tag 1.19.0).
version_norm() { local v=${1#v}; printf '%s' "${v%%+*}"; }

version_ge() {  # true when <a> is the same as, or newer than, <b>
    local a b
    a=$(version_norm "$1"); b=$(version_norm "$2")
    [[ $a =~ ^[0-9] && $b =~ ^[0-9] ]] || return 1      # "none", "?" and the like never count as a version
    [[ $a == "$b" ]] && return 0
    [[ $(printf '%s\n%s\n' "$a" "$b" | sort -V | tail -n1) == "$a" ]]
}

refresh_status() {
    local id=$1 json
    ST_INSTALLED[$id]="?"; ST_LATEST[$id]="?"; ST_STATE[$id]="error"; ST_JSON[$id]=""
    ST_RELEASED[$id]="-"; ST_ON[$id]="-"
    load_app "$id" || return 0
    ST_INSTALLED[$id]=$(get_installed_version) || return 0
    if [[ ${ST_INSTALLED[$id]} != none ]]; then ST_ON[$id]=$(get_installed_date); fi
    json=$(find_latest) || return 0
    ST_JSON[$id]=$json
    parse_latest "$json"
    ST_LATEST[$id]=$LATEST_VER
    ST_RELEASED[$id]=${LATEST_DATE:-"-"}
    if [[ ${ST_INSTALLED[$id]} == none ]]; then
        ST_STATE[$id]="not installed"
    elif version_ge "${ST_INSTALLED[$id]}" "$LATEST_VER"; then
        ST_STATE[$id]="up to date"
    else
        ST_STATE[$id]="update available"
    fi
}

refresh_all() {
    local id
    for id in $(list_app_ids); do refresh_status "$id"; done
    STATUS_FRESH=1
}

ensure_status() { [[ $STATUS_FRESH -eq 1 ]] || refresh_all; }

print_table() {
    local id i=0 color
    printf '%s%-3s %-20s %-13s %-13s %-11s %-13s %s%s\n' "$C_BLD" "#" "PROGRAM" "INSTALLED" "LATEST" "RELEASED" "INSTALLED ON" "STATUS" "$C_RST"
    for id in $(list_app_ids); do
        i=$((i + 1))
        case ${ST_STATE[$id]:-error} in
            "up to date") color=$C_GRN ;;
            "update available"|"not installed") color=$C_YEL ;;
            *) color=$C_RED ;;
        esac
        printf '%-3s %-20.20s %-13.13s %-13.13s %-11s %-13s %s%s%s\n' "$i" "$id" \
            "${ST_INSTALLED[$id]:-?}" "${ST_LATEST[$id]:-?}" "${ST_RELEASED[$id]:--}" "${ST_ON[$id]:--}" \
            "$color" "${ST_STATE[$id]:-error}" "$C_RST"
    done
}

print_tracked() {  # offline: no GitHub calls
    local id i=0 inst on
    printf '%s%-3s %-20s %-22s %-28s %-13s %s%s\n' "$C_BLD" "#" "ID" "NAME" "REPO" "INSTALLED" "INSTALLED ON" "$C_RST"
    for id in $(list_app_ids); do
