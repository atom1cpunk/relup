set -euo pipefail

TOOL_NAME="relup"
TOOL_VERSION="0.2.1"

CONF_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/${TOOL_NAME}"
APPS_DIR="${CONF_ROOT}/apps.d"
SETTINGS_FILE="${CONF_ROOT}/settings.conf"

# Defaults; overridden by settings.conf
DOWNLOAD_DIR="/tmp"
CLEAR_SCREEN="yes"

ASSUME_YES=0            # -y: answer yes to ordinary prompts
SKIP_UPDATE_CONFIRM=0   # set during "update all" after the batch was confirmed once
TMP_DIR=""

# ---------- output helpers ----------
if [[ -t 1 ]]; then
    C_RED=$'\e[31m'; C_GRN=$'\e[32m'; C_YEL=$'\e[33m'; C_BLD=$'\e[1m'; C_RST=$'\e[0m'
else
    C_RED=""; C_GRN=""; C_YEL=""; C_BLD=""; C_RST=""
fi
info() { printf '%s\n' "$*"; }
ok()   { printf '%s%s%s\n' "$C_GRN" "$*" "$C_RST"; }
warn() { printf '%s%s%s\n' "$C_YEL" "$*" "$C_RST" >&2; }
err()  { printf '%s%s%s\n' "$C_RED" "$*" "$C_RST" >&2; }

usage() {
    cat <<EOF
${TOOL_NAME} ${TOOL_VERSION} — update programs installed from GitHub releases

USAGE
  ${TOOL_NAME} [options] [command]

COMMANDS
  (none)                  Open the interactive menu
  add [URL|owner/repo]    Start tracking a program (guided)
  list                    List tracked programs and installed versions (offline)
  check                   Compare installed vs. latest version for every program
  update <id>             Update one program
  update --all            Update every program that has a newer release
  edit <id>               Edit a program's config in your editor
  remove <id>             Uninstall a program and/or stop tracking it
  config                  Edit ${TOOL_NAME}'s own settings
  help                    Show this help

OPTIONS
  -y, --yes               Answer yes to confirmation prompts
                          (uninstalling always asks)
  -h, --help              Show this help
  -V, --version           Show the version

FILES
  ${APPS_DIR}/<id>.conf
                          one config file per tracked program
  ${SETTINGS_FILE}
                          ${TOOL_NAME} settings (download folder)

ENVIRONMENT
  GITHUB_TOKEN            Optional. Raises the GitHub API limit from 60 to
                          5000 requests per hour.
  VISUAL / EDITOR         Editor used by 'edit' and 'config'.

EXAMPLES
  ${TOOL_NAME} add https://github.com/brave/brave-browser/releases
  ${TOOL_NAME} check
  ${TOOL_NAME} update --all
EOF
}

# ---------- prompts ----------
ANSWER=""
ask() {  # ask <prompt> [default]  -> sets ANSWER; Ctrl-D exits cleanly
    local prompt=$1 default=${2:-}
    if [[ -n $default ]]; then
        printf '%s [%s]: ' "$prompt" "$default" >&2
    else
        printf '%s: ' "$prompt" >&2
    fi
    read -r ANSWER || { echo >&2; exit 0; }
    ANSWER=${ANSWER:-$default}
}

_confirm() {  # _confirm <message> <default y|n>
    local reply hint="[y/N]"
    [[ $2 == y ]] && hint="[Y/n]"
    printf '%s %s ' "$1" "$hint" >&2
    read -r reply || { echo >&2; exit 0; }
    reply=${reply:-$2}
    [[ $reply =~ ^[Yy] ]]
}
confirm() {  # honours -y
    if [[ $ASSUME_YES -eq 1 ]]; then return 0; fi
    _confirm "$1" "${2:-n}"
}
confirm_strict() { _confirm "$1" "${2:-n}"; }  # ignores -y (destructive actions)

# ---------- setup ----------
check_deps() {
    local missing=() cmd
    for cmd in curl jq sha256sum; do
        command -v "$cmd" >/dev/null || missing+=("$cmd")
    done
    if ((${#missing[@]})); then
        err "Missing required tools: ${missing[*]}"
        exit 1
    fi
}

cleanup() {
    if [[ -n $TMP_DIR ]]; then rm -rf "$TMP_DIR"; fi
    TMP_DIR=""
    return 0
}
trap cleanup EXIT

write_default_settings() {
    cat > "$SETTINGS_FILE" <<EOF
# ${TOOL_NAME} settings
# Format: KEY=value   (one per line, no inline comments; lines starting with # are ignored)

# Folder where downloads are staged before installing.
# A temporary subfolder is created here and removed afterwards.
DOWNLOAD_DIR=/tmp

# Clear the screen before each menu and job (yes or no).
CLEAR_SCREEN=yes
EOF
}

init_config() {
    mkdir -p "$APPS_DIR"
    local f
    shopt -s nullglob
    for f in "$APPS_DIR"/*.conf; do
        [[ $(basename "$f" .conf) =~ ^[A-Za-z0-9._-]+$ ]] \
            || warn "Ignoring ${f}: program file names may only use letters, digits, '.', '-' and '_'."
    done
    shopt -u nullglob
    [[ -f $SETTINGS_FILE ]] || write_default_settings
    parse_conf "$SETTINGS_FILE" "DOWNLOAD_DIR CLEAR_SCREEN"
}

# ---------- config parsing ----------
# Config files are plain KEY='value' data, never executed as shell code.
# Only whitelisted keys are accepted.
parse_conf() {  # parse_conf <file> "<ALLOWED KEYS>"
    local file=$1 allowed=" $2 " line key val
    while IFS= read -r line || [[ -n $line ]]; do
        if [[ $line =~ ^[[:space:]]*(#.*)?$ ]]; then continue; fi
        if [[ $line =~ ^[[:space:]]*([A-Z_]+)[[:space:]]*=[[:space:]]*(.*)$ ]]; then
            key=${BASH_REMATCH[1]}
            val=${BASH_REMATCH[2]}
            val=${val%"${val##*[![:space:]]}"}          # trim trailing whitespace
            if [[ $val =~ ^\"(.*)\"$ ]]; then
                val=${BASH_REMATCH[1]}
            elif [[ $val =~ ^\'(.*)\'$ ]]; then
                val=${BASH_REMATCH[1]}
            fi
            if [[ $val == "~/"* ]]; then val="${HOME}/${val#"~/"}"; fi
            if [[ $allowed == *" $key "* ]]; then
                printf -v "$key" '%s' "$val"
            else
                warn "${file##*/}: ignoring unknown setting '${key}'"
            fi
        else
            warn "${file##*/}: cannot parse line: ${line}"
        fi
    done < "$file"
}

# ---------- tracked programs ----------
APP_KEYS="NAME SOURCE REPO TAG_PREFIX ASSET_REGEX INSTALL PKG VERIFY_CHECKSUM"

list_app_ids() {
    local f id
    shopt -s nullglob
    for f in "$APPS_DIR"/*.conf; do
        id=$(basename "$f" .conf)
        if [[ $id =~ ^[A-Za-z0-9._-]+$ ]]; then printf '%s\n' "$id"; fi
    done
    shopt -u nullglob
}

has_apps() { [[ -n $(list_app_ids) ]]; }

load_app() {
    local id=$1 file="${APPS_DIR}/$1.conf"
    if [[ ! $id =~ ^[A-Za-z0-9._-]+$ || ! -f $file ]]; then
        err "Unknown program: ${id}"
        return 1
    fi
    NAME="$id"; SOURCE="github"; REPO=""; TAG_PREFIX=""; ASSET_REGEX=""
    INSTALL="rpm"; PKG="$id"; VERIFY_CHECKSUM="auto"
    parse_conf "$file" "$APP_KEYS"

    local bad=""
    [[ $REPO =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]      || bad="REPO must look like owner/repo"
    [[ -n $ASSET_REGEX ]]                                 || bad="ASSET_REGEX is empty"
    [[ $PKG =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]]          || bad="PKG is missing or has invalid characters"
    [[ $INSTALL =~ ^[a-z0-9_]+$ ]] && declare -F "install_${INSTALL}" >/dev/null \
                                                          || bad="INSTALL '${INSTALL}' is not supported"
    declare -F "${SOURCE}_releases" >/dev/null 2>&1       || bad="SOURCE '${SOURCE}' is not supported"
    [[ $VERIFY_CHECKSUM =~ ^(auto|required|skip)$ ]]      || bad="VERIFY_CHECKSUM must be auto, required or skip"
    if [[ -n $bad ]]; then
        err "${id}: ${bad} (${file})"
        return 1
    fi
}

# ---------- GitHub ----------
gh_api() {  # gh_api <path> -> prints JSON body
    local path=$1 out code auth=()
    if [[ -n ${GITHUB_TOKEN:-} ]]; then auth=(-H "Authorization: Bearer ${GITHUB_TOKEN}"); fi
    out=$(curl -sSL "${auth[@]}" -H 'Accept: application/vnd.github+json' \
               -w $'\n%{http_code}' "https://api.github.com/${path}") || {
        err "Could not reach GitHub (network problem?)"
        return 1
    }
    code=${out##*$'\n'}
    out=${out%$'\n'*}
    case $code in
        200)     printf '%s' "$out" ;;
        403|429) err "GitHub refused the request (API rate limit? set GITHUB_TOKEN to raise it)"; return 1 ;;
        404)     err "Not found on GitHub: ${path%%\?*}"; return 1 ;;
        *)       err "GitHub API returned HTTP ${code} for ${path%%\?*}"; return 1 ;;
    esac
}

# Prints normalized releases: [{tag, draft, prerelease, date, assets:[{name,url,size,digest}]}]
# Other sources (e.g. GitLab) can be added later by providing <source>_releases with the same output.
github_releases() {  # github_releases <owner/repo> [page]
    local json page=${2:-1} query="per_page=100"
    if ((page > 1)); then query+="&page=${page}"; fi
    json=$(gh_api "repos/$1/releases?${query}") || return 1
    jq -c '[ .[] | {
                tag: .tag_name,
                draft: (.draft // false),
                prerelease: (.prerelease // false),
                date: (.published_at // ""),
                assets: [ .assets[] | {
                    name: .name,
                    url: .browser_download_url,
                    size: (.size // 0),
                    digest: (.digest // "") } ] } ]' <<< "$json"
}

get_releases() { "${SOURCE}_releases" "$@"; }

# Sets LATEST_* for the loaded app. Prints the matching release as JSON.
find_latest() {
    local releases result page count
    # Busy repos can bury a product's newest release past page 1, so look at up to 3 pages,
    # stopping as soon as a match is found or a page comes back short (no more releases).
    for page in 1 2 3; do
        releases=$(get_releases "$REPO" "$page") || return 1
        result=$(jq -c --arg p "$TAG_PREFIX" --arg re "$ASSET_REGEX" '
            [ .[]
              | select(.draft == false and .prerelease == false)
              | select(.tag | startswith($p))
              | . as $rel
              | ([ $rel.assets[] | select(.name | test($re)) ] | first) as $a
              | select($a != null)
              | { tag: $rel.tag,
                  version: ($rel.tag | ltrimstr($p) | ltrimstr("v")),
                  date: $rel.date,
                  asset: $a,
                  assets: $rel.assets }
            ] | first // empty' <<< "$releases") || {
            err "${NAME}: could not evaluate ASSET_REGEX (is it a valid regex?)"
            return 1
        }
        if [[ -n $result ]]; then printf '%s' "$result"; return 0; fi
        count=$(jq 'length' <<< "$releases") || count=0
        if ((count < 100)); then break; fi
    done
    err "${NAME}: no release found with a file matching ASSET_REGEX"
    return 1
}

LATEST_JSON=""; LATEST_VER=""; LATEST_TAG=""; LATEST_NAME=""; LATEST_URL=""; LATEST_DIGEST=""
LATEST_DATE=""; LATEST_SIZE=0
parse_latest() {
    local f=() d
    LATEST_JSON=$1
    mapfile -t f < <(jq -r '.version, .tag, .asset.name, .asset.url, .asset.digest, .date, .asset.size' <<< "$1")
    LATEST_VER=${f[0]}; LATEST_TAG=${f[1]}; LATEST_NAME=${f[2]##*/}; LATEST_URL=${f[3]}
    LATEST_DIGEST=${f[4]:-}; d=${f[5]:-}; LATEST_DATE=${d:0:10}; LATEST_SIZE=${f[6]:-0}
}

# ---------- install methods ----------
# A method <m> provides: installed_version_<m>, install_<m> <file> <installed_ver>, uninstall_<m>
installed_version_rpm() {
    local out
    if out=$(rpm -q --qf '%{VERSION}' "$PKG" 2>/dev/null); then
        printf '%s' "$out"
    else
        printf 'none'
    fi
}

install_rpm() {
    local file=$1 installed=$2
    if [[ $installed == none ]]; then
        sudo dnf install -y "$file"
    else
        sudo dnf upgrade -y "$file"
    fi
}

uninstall_rpm() { sudo dnf remove -y "$PKG"; }

package_name_rpm() { rpm -qp --qf '%{NAME}' "$1" 2>/dev/null; }

installed_date_rpm() {
    local t
    t=$(rpm -q --qf '%{INSTALLTIME}' "$PKG" 2>/dev/null) || return 1
    [[ $t =~ ^[0-9]+$ ]] || return 1
    date -d "@${t}" +%F
}

# An rpm starts with its metadata, so the package name can be read from just the first
# part of the file instead of downloading all of it. Prints the name, or fails.
remote_package_name_rpm() {  # remote_package_name_rpm <url>
    local url=$1 tmp name n
    command -v rpm >/dev/null || return 1
    mkdir -p "$DOWNLOAD_DIR"
    tmp=$(mktemp -p "$DOWNLOAD_DIR" "${TOOL_NAME}-header.XXXXXX") || return 1
    for n in 524288 4194304; do
        if curl -fsSL -r "0-$((n - 1))" --max-filesize $((n * 2)) "$url" -o "$tmp" 2>/dev/null; then
            name=$(rpm -qp --nosignature --nodigest --qf '%{NAME}' "$tmp" 2>/dev/null) || name=""
            if [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]]; then
                rm -f "$tmp"; printf '%s' "$name"; return 0
            fi
        fi
    done
    rm -f "$tmp"
    return 1
}

set_conf_value() {  # set_conf_value <file> <KEY> <value>: rewrites that line, or appends it
    local file=$1 key=$2 val line found=0 tmp
    val=$(clean_value "$3")
    tmp=$(mktemp "${file}.XXXXXX") || return 1
    while IFS= read -r line || [[ -n $line ]]; do
        if [[ $line == "${key}="* ]]; then
            printf "%s='%s'\n" "$key" "$val"; found=1
        else
            printf '%s\n' "$line"
        fi
    done < "$file" > "$tmp"
    if [[ $found -eq 0 ]]; then printf "%s='%s'\n" "$key" "$val" >> "$tmp"; fi
    chmod --reference="$file" "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$file"
}

get_installed_version() { "installed_version_${INSTALL}"; }

get_installed_date() {  # date the package was installed or last upgraded, or "-"
    local d
    if declare -F "installed_date_${INSTALL}" >/dev/null && d=$("installed_date_${INSTALL}"); then
        printf '%s' "$d"
    else
        printf -- '-'
    fi
}

# ---------- status ----------
declare -A ST_INSTALLED ST_LATEST ST_STATE ST_JSON ST_RELEASED ST_ON
STATUS_FRESH=0

# rpm versions often carry build metadata the release tag lacks (1.19.0+65 vs tag 1.19.0).
version_norm() { local v=${1#v}; printf '%s' "${v%%+*}"; }

version_ge() {  # true when <a> is the same as, or newer than, <b>
    local a b
    a=$(version_norm "$1"); b=$(version_norm "$2")
    [[ $a =~ ^[0-9] && $b =~ ^[0-9] ]] || return 1      # "none", "?" and the like never count as a version
    [[ $a == "$b" ]] && return 0
    [[ $(printf '%s\n%s\n' "$a" "$b" | sort -V | tail -n1) == "$a" ]]
}

refresh_status() {
    local id=$1 json
    ST_INSTALLED[$id]="?"; ST_LATEST[$id]="?"; ST_STATE[$id]="error"; ST_JSON[$id]=""
    ST_RELEASED[$id]="-"; ST_ON[$id]="-"
    load_app "$id" || return 0
    ST_INSTALLED[$id]=$(get_installed_version) || return 0
    if [[ ${ST_INSTALLED[$id]} != none ]]; then ST_ON[$id]=$(get_installed_date); fi
    json=$(find_latest) || return 0
    ST_JSON[$id]=$json
    parse_latest "$json"
    ST_LATEST[$id]=$LATEST_VER
    ST_RELEASED[$id]=${LATEST_DATE:-"-"}
    if [[ ${ST_INSTALLED[$id]} == none ]]; then
        ST_STATE[$id]="not installed"
    elif version_ge "${ST_INSTALLED[$id]}" "$LATEST_VER"; then
        ST_STATE[$id]="up to date"
    else
        ST_STATE[$id]="update available"
    fi
}

refresh_all() {
    local id
    for id in $(list_app_ids); do refresh_status "$id"; done
    STATUS_FRESH=1
}

ensure_status() { [[ $STATUS_FRESH -eq 1 ]] || refresh_all; }

print_table() {
    local id i=0 color
    printf '%s%-3s %-20s %-13s %-13s %-11s %-13s %s%s\n' "$C_BLD" "#" "PROGRAM" "INSTALLED" "LATEST" "RELEASED" "INSTALLED ON" "STATUS" "$C_RST"
    for id in $(list_app_ids); do
        i=$((i + 1))
        case ${ST_STATE[$id]:-error} in
            "up to date") color=$C_GRN ;;
            "update available"|"not installed") color=$C_YEL ;;
            *) color=$C_RED ;;
        esac
        printf '%-3s %-20.20s %-13.13s %-13.13s %-11s %-13s %s%s%s\n' "$i" "$id" \
            "${ST_INSTALLED[$id]:-?}" "${ST_LATEST[$id]:-?}" "${ST_RELEASED[$id]:--}" "${ST_ON[$id]:--}" \
            "$color" "${ST_STATE[$id]:-error}" "$C_RST"
    done
}

print_tracked() {  # offline: no GitHub calls
    local id i=0 inst on
    printf '%s%-3s %-20s %-22s %-28s %-13s %s%s\n' "$C_BLD" "#" "ID" "NAME" "REPO" "INSTALLED" "INSTALLED ON" "$C_RST"
    for id in $(list_app_ids); do
        i=$((i + 1))
        if load_app "$id" 2>/dev/null; then
            inst=$(get_installed_version 2>/dev/null) || inst="?"
            on="-"
            if [[ $inst == none ]]; then inst="not installed"; elif [[ $inst != "?" ]]; then on=$(get_installed_date); fi
            printf '%-3s %-20.20s %-22.22s %-28.28s %-13.13s %s\n' "$i" "$id" "$NAME" "$REPO" "$inst" "$on"
        else
            printf '%-3s %-20.20s %s(config has errors, try: %s edit %s)%s\n' "$i" "$id" "$C_RED" "$TOOL_NAME" "$id" "$C_RST"
        fi
    done
}

# ---------- checksums ----------
# Order of trust: (1) digest GitHub publishes for the asset, (2) a checksum file attached
# to the same release. Note: both come from the same release as the download, so this
# catches corrupted/truncated downloads and swapped files, not a compromised release.
checksum_candidates() {  # prints URLs of possible checksum files, best first
    jq -r --arg n "$LATEST_NAME" '
        def bad: test("(?i)\\.(sig|asc|pem|minisig|cert|bundle|sbom)$");
        [ .assets[] | select(.size < 2097152) ] as $all
        | ( [ $all[] | select(.name != $n)
              | select((.name | ascii_downcase | startswith($n | ascii_downcase))
                       and (.name | test("(?i)sha|checksum|digest|\\.sum")))
              | select(.name | bad | not) ]
          + [ $all[] | select(.name != $n)
              | select(.name | test("(?i)sha256|sha512|checksum|sums"))
              | select(.name | bad | not) ] )
        | .[:6] | .[].url' <<< "$LATEST_JSON" | awk '!seen[$0]++'
}

extract_hash() {  # extract_hash <checksum-file> <asset-name> <is-sidecar 0|1>
    local cs=$1 name=$2 sidecar=$3 line="" lines
    line=$(grep -F -- "$name" "$cs" 2>/dev/null | head -n1 || true)
    if [[ -z $line && $sidecar -eq 1 ]]; then
        lines=$(grep -c . "$cs" 2>/dev/null || true)
        if [[ ${lines:-0} -eq 1 ]]; then line=$(grep . "$cs" | head -n1); fi
    fi
    [[ -n $line ]] || return 0
    grep -Eo '\b([0-9a-fA-F]{128}|[0-9a-fA-F]{64})\b' <<< "$line" | head -n1 || true
}

hash_of() {  # hash_of <algo> <file>
    case $1 in
        sha256) sha256sum "$2" | cut -d' ' -f1 ;;
        sha512) sha512sum "$2" | cut -d' ' -f1 ;;
        *) return 1 ;;
    esac
}

# Returns 0 = verified, 1 = MISMATCH, 2 = no checksum available
verify_checksum() {  # verify_checksum <downloaded-file>
    local file=$1 want="" algo="" src="" got url cs sidecar
    if [[ $LATEST_DIGEST == *:* ]]; then
        algo=${LATEST_DIGEST%%:*}; want=${LATEST_DIGEST#*:}; src="the digest GitHub lists for this file"
    else
        cs="${TMP_DIR}/checksum.txt"
        while IFS= read -r url; do
            [[ -n $url ]] || continue
            curl -fsSL --max-filesize 2097152 "$url" -o "$cs" 2>/dev/null || continue
            sidecar=0
            [[ ${url##*/} == "$LATEST_NAME"* ]] && sidecar=1
            want=$(extract_hash "$cs" "$LATEST_NAME" "$sidecar")
            if [[ -n $want ]]; then
                case ${#want} in 64) algo=sha256 ;; 128) algo=sha512 ;; esac
                src="${url##*/}"
                break
            fi
        done < <(checksum_candidates)
    fi
    [[ -n $want && -n $algo ]] || return 2
    got=$(hash_of "$algo" "$file") || { warn "Unsupported hash algorithm '${algo}'"; return 2; }
    if [[ ${got,,} == "${want,,}" ]]; then
        ok "Checksum OK (${algo}, from ${src})"
        return 0
    fi
    err "  expected: ${want}"
    err "  actual:   ${got}"
    return 1
}

verify_download() {  # applies the program's VERIFY_CHECKSUM policy
    local file=$1 rc=0
    if [[ $VERIFY_CHECKSUM == skip ]]; then
        warn "Checksum verification is turned off for ${NAME}."
        return 0
    fi
    verify_checksum "$file" || rc=$?
    case $rc in
        0) return 0 ;;
        1) err "CHECKSUM MISMATCH for ${LATEST_NAME} — the file was not installed."; return 1 ;;
        *)
            if [[ $VERIFY_CHECKSUM == required ]]; then
                err "No checksum is published for ${LATEST_NAME} and VERIFY_CHECKSUM=required — not installing."
                return 1
            fi
            warn "No checksum is published for ${LATEST_NAME}; its integrity cannot be verified."
            confirm_strict "Install it anyway?" n   # -y does not skip this; set VERIFY_CHECKSUM='skip' per program instead
            ;;
    esac
}

# ---------- update ----------
BAR_WIDTH=30

fmt_size() {  # bytes -> "NNN KB" or "NNN MB"
    if (($1 >= 1048576)); then printf '%d MB' "$(($1 / 1048576))"; else printf '%d KB' "$((($1 + 1023) / 1024))"; fi
}

draw_bar() {  # draw_bar <bytes-so-far> <total-bytes>
    local got=$1 total=$2 pct n filled
    pct=$(( got * 100 / total ))
    if ((pct > 100)); then pct=100; fi
    n=$(( pct * BAR_WIDTH / 100 ))
    printf -v filled '%*s' "$n" ''
    filled=${filled// /*}
    printf '\r  [%-*s] %3d%%  %s / %s ' "$BAR_WIDTH" "$filled" "$pct" "$(fmt_size "$got")" "$(fmt_size "$total")" >&2
}

download_file() {  # download_file <url> <dest> [expected-bytes]; draws a bar when run in a terminal
    local url=$1 dest=$2 total=${3:-0} pid rc=0 got
    if [[ ! -t 2 || $total -le 0 ]]; then
        curl -fsSL "$url" -o "$dest"
        return
    fi
    curl -fsSL "$url" -o "$dest" &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        got=$(stat -c %s "$dest" 2>/dev/null || echo 0)
        draw_bar "$got" "$total"
        sleep 0.2
    done
    wait "$pid" || rc=$?
    if [[ $rc -eq 0 ]]; then draw_bar "$total" "$total"; fi
    printf '\n' >&2
    return $rc
}

_download_and_install() {  # _download_and_install <id> <installed-version>; returns 3 = nothing to do
    local id=$1 installed=$2 dest="${TMP_DIR}/${LATEST_NAME}" real="" after
    if ((LATEST_SIZE > 0)); then
        info "Downloading ${LATEST_NAME} ($(fmt_size "$LATEST_SIZE"))"
    else
        info "Downloading ${LATEST_NAME}"
    fi
    download_file "$LATEST_URL" "$dest" "$LATEST_SIZE" || { err "Download failed."; return 1; }
    verify_download "$dest" || return 1

    # The file knows its real package name; keep the config in agreement with it.
    if declare -F "package_name_${INSTALL}" >/dev/null; then
        real=$("package_name_${INSTALL}" "$dest" || true)
    fi
    if [[ -n $real && $real != "$PKG" && $real =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]]; then
        info "This file is the package '${real}' (the config said '${PKG}'); config corrected."
        set_conf_value "${APPS_DIR}/${id}.conf" PKG "$real"
        PKG=$real
        installed=$(get_installed_version) || installed="none"
        ST_INSTALLED[$id]=$installed
        if version_ge "$installed" "$LATEST_VER"; then return 3; fi
    fi

    "install_${INSTALL}" "$dest" "$installed" || { err "Install failed."; return 1; }

    # Don't trust the installer's exit code alone: confirm something actually changed.
    after=$(get_installed_version) || after="?"
    if [[ $after == none ]]; then
        err "The install command finished, but '${PKG}' is not installed according to ${INSTALL}. Check PKG in the config."
        return 1
    elif version_ge "$after" "$LATEST_VER"; then
        :
    elif [[ $after != "$installed" ]]; then
        warn "Installed ${after}, which doesn't match release ${LATEST_VER}; the version formats may differ."
    else
        err "Nothing changed: ${PKG} is still at ${after} after the install command."
        return 1
    fi
    ST_INSTALLED[$id]=$after
}

update_app() {
    local id=$1 installed from rc=0
    [[ -n ${ST_STATE[$id]:-} ]] || refresh_status "$id"
    case ${ST_STATE[$id]:-error} in
        error) return 1 ;;
        "up to date") info "${id} is already up to date (${ST_LATEST[$id]}, installed ${ST_ON[$id]:--})."; return 0 ;;
    esac
    load_app "$id" || return 1
    parse_latest "${ST_JSON[$id]}"
    installed=${ST_INSTALLED[$id]}
    from=$installed; [[ $installed == none ]] && from="not installed"
    info "${C_BLD}${NAME}${C_RST}: ${from} -> ${LATEST_VER}${LATEST_DATE:+  (released ${LATEST_DATE})}"
    if [[ $SKIP_UPDATE_CONFIRM -eq 0 ]]; then
        confirm "Proceed?" n || { info "Skipped ${id}."; return 0; }
    fi

    mkdir -p "$DOWNLOAD_DIR"
    TMP_DIR=$(mktemp -d -p "$DOWNLOAD_DIR" "${TOOL_NAME}.XXXXXX") || {
        err "Cannot create a temporary folder in ${DOWNLOAD_DIR}"; return 1; }
    _download_and_install "$id" "$installed" || rc=$?
    cleanup
    case $rc in
        0) ok "${id} is now at ${ST_INSTALLED[$id]} (installed $(get_installed_date))." ;;
        3) ok "${id} is already at ${ST_INSTALLED[$id]} (installed $(get_installed_date)); nothing to install." ;;
        *) err "${id}: not updated."; return 1 ;;
    esac
    ST_ON[$id]=$(get_installed_date)
    if version_ge "${ST_INSTALLED[$id]}" "$LATEST_VER"; then
        ST_STATE[$id]="up to date"
    else
        ST_STATE[$id]="update available"
    fi
}

update_all() {
    refresh_all
    print_table
    local id todo=() failed=()
    for id in $(list_app_ids); do
        if [[ ${ST_STATE[$id]} == "update available" ]]; then todo+=("$id"); fi
    done
    if ((${#todo[@]} == 0)); then
        info "Nothing to update."
        return 0
    fi
    info
    info "Will update: ${todo[*]}"
    confirm "Proceed with all?" n || return 0
    SKIP_UPDATE_CONFIRM=1
    for id in "${todo[@]}"; do
        update_app "$id" || failed+=("$id")
    done
    SKIP_UPDATE_CONFIRM=0
    if ((${#failed[@]})); then
        err "Failed: ${failed[*]}"
        return 1
    fi
}

# ---------- add a program (guided) ----------
W_REPO=""; W_TAG=""; W_USER=""; W_RELEASE=""; W_TAGNAME=""; W_ASSET=""

clean_value() {  # safe to put inside single quotes on one line
    local s=${1//$'\n'/ }
    printf '%s' "${s//\'/}"
}

slugify() {
    tr 'A-Z' 'a-z' <<< "$1" | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

pretty_name() {  # brave-browser -> Brave Browser
    tr '_-' '  ' <<< "$1" | sed -E 's/\b(.)/\u\1/g'
}

regex_escape() { printf '%s' "$1" | sed -E 's/[][\\.^$*+?(){}|]/\\&/g'; }

# Turns a concrete file name into a pattern that survives version bumps:
#   brave-browser-1.85.118-1.x86_64.rpm -> ^brave-browser-[0-9][0-9.]*-1\.x86_64\.rpm$
build_asset_regex() {  # build_asset_regex <asset-name> <version>
    local name=$1 ver=$2 out="" head tail
    local before_re='[0-9.]$' after_re='^([0-9]|\.[0-9])'
    if [[ -n $ver ]]; then
        while [[ $name == *"$ver"* ]]; do
            head=${name%%"$ver"*}
            tail=${name#*"$ver"}
            if [[ $head =~ $before_re || $tail =~ $after_re ]]; then
                out+="$(regex_escape "${head}${ver}")"      # part of a longer number: keep it literal
            else
                out+="$(regex_escape "$head")"'[0-9][0-9.]*'
            fi
            name=$tail
        done
    fi
    out+="$(regex_escape "$name")"
    printf '^%s$' "$out"
}

parse_repo_input() {  # sets W_REPO / W_TAG, or W_USER when only a username was given
    local in=$1 owner="" repo="" rest=""
    W_REPO=""; W_TAG=""; W_USER=""
    in=${in#"${in%%[![:space:]]*}"}
    in=${in%"${in##*[![:space:]]}"}
    in=${in#http://}; in=${in#https://}; in=${in#www.}; in=${in#github.com/}
    in=${in%%[?#]*}
    in=${in%/}
    IFS=/ read -r owner repo rest <<< "$in"
    repo=${repo%.git}
    [[ $owner =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || return 1
    if [[ -z $repo ]]; then W_USER=$owner; return 0; fi
    [[ $repo =~ ^[A-Za-z0-9._-]+$ ]] || return 1
    W_REPO="${owner}/${repo}"
    if [[ $rest == releases/tag/* ]]; then W_TAG=${rest#releases/tag/}; fi
    return 0
}

wizard_pick_user_repo() {  # sets W_REPO
    local user=$1 json rows=() row i=0 name desc shown=40
    info "Looking up repositories of ${user}..."
    json=$(gh_api "users/${user}/repos?per_page=100&sort=pushed") || return 1
    mapfile -t rows < <(jq -r '.[] | select(.archived | not)
                               | [.name, ((.description // "") | .[0:60])] | join("\t")' <<< "$json")
    ((${#rows[@]})) || { err "No public repositories found for ${user}."; return 1; }
    for row in "${rows[@]:0:shown}"; do
        i=$((i + 1))
        IFS=$'\t' read -r name desc <<< "$row"
        printf '  %2d) %-28s %s\n' "$i" "$name" "$desc"
    done
    if ((${#rows[@]} > shown)); then info "  (showing the ${shown} most recently pushed; you can also type a repo name)"; fi
    ask "Repository number or name"
    if [[ $ANSWER =~ ^[0-9]+$ ]] && ((ANSWER >= 1 && ANSWER <= ${#rows[@]})); then
        IFS=$'\t' read -r name desc <<< "${rows[ANSWER-1]}"
        W_REPO="${user}/${name}"
    elif [[ $ANSWER =~ ^[A-Za-z0-9._-]+$ ]]; then
        W_REPO="${user}/${ANSWER}"
    else
        err "Invalid selection."; return 1
    fi
}

wizard_pick_release() {  # sets W_RELEASE (json) and W_TAGNAME
    local releases rows=() row t d c i=0 shown=15
    releases=$(get_releases "$W_REPO") || return 1
    W_RELEASE=""
    if [[ -n $W_TAG ]]; then
        W_RELEASE=$(jq -c --arg t "$W_TAG" '[.[] | select(.tag == $t)] | first // empty' <<< "$releases")
        if [[ -n $W_RELEASE ]]; then
            W_TAGNAME=$W_TAG
            info "Using release ${W_TAG} from the URL."
            return 0
        fi
        warn "Release '${W_TAG}' is not among the 100 most recent; pick one from the list instead."
    fi
    mapfile -t rows < <(jq -r '.[] | select(.draft | not) | select(.prerelease | not)
                               | select((.assets | length) > 0)
                               | [.tag, (if .date == "" then "-" else .date[0:10] end), (.assets | length | tostring)]
                               | join("\t")' <<< "$releases")
    ((${#rows[@]})) || { err "No published releases with downloadable files in ${W_REPO}."; return 1; }
    info
    info "Recent releases (1 = latest). Some repos publish several products;"
    info "pick a release of the product you want to track."
    for row in "${rows[@]:0:shown}"; do
        i=$((i + 1))
        IFS=$'\t' read -r t d c <<< "$row"
        printf '  %2d) %-34s %s  (%s %s)\n' "$i" "$t" "$d" "$c" "$([[ $c == 1 ]] && echo file || echo files)"
    done
    ask "Release number" "1"
    if [[ ! $ANSWER =~ ^[0-9]+$ ]] || ((ANSWER < 1 || ANSWER > i)); then err "Invalid selection."; return 1; fi
    IFS=$'\t' read -r t d c <<< "${rows[ANSWER-1]}"
    W_TAGNAME=$t
    W_RELEASE=$(jq -c --arg t "$t" '[.[] | select(.tag == $t)] | first // empty' <<< "$releases")
}

W_ASSET=""; W_ASSET_URL=""; W_ASSET_SIZE=0
list_rpm_assets() {  # list_rpm_assets <arch-regex or ""> -> "name<TAB>size<TAB>url" lines
    jq -r --arg re "$1" '.assets[]
        | select(.name | test("\\.rpm$"))
        | select(($re == "") or (.name | test($re; "i")))
        | [.name, (.size | tostring), .url] | join("\t")' <<< "$W_RELEASE"
}

wizard_pick_asset() {  # sets W_ASSET, W_ASSET_URL, W_ASSET_SIZE
    local host_label host_re other_label other_re re rows=() row name size url i=0
    case $(uname -m) in
        x86_64)        host_label="x86_64";          host_re='x86[_-]64|amd64|x64'
                       other_label="arm64 / aarch64"; other_re='aarch64|arm[_-]?64' ;;
        aarch64|arm64) host_label="arm64 / aarch64"; host_re='aarch64|arm[_-]?64'
                       other_label="x86_64";          other_re='x86[_-]64|amd64|x64' ;;
        *)             host_label=$(uname -m);       host_re=$(uname -m)
                       other_label="x86_64";          other_re='x86[_-]64|amd64|x64' ;;
    esac
    info
    info "Which build do you want?"
    info "  1) ${host_label} (this machine)"
    info "  2) ${other_label}"
    info "  3) Show every .rpm file in the release"
    ask "Choice" "1"
    case $ANSWER in 2) re=$other_re ;; 3) re="" ;; *) re=$host_re ;; esac

    mapfile -t rows < <(list_rpm_assets "$re")
    if ((${#rows[@]} == 0)) && [[ -n $re ]]; then
        mapfile -t rows < <(list_rpm_assets "")
        if ((${#rows[@]})); then warn "No .rpm file in that release mentions that architecture; showing all .rpm files."; fi
    fi
    if ((${#rows[@]} == 0)); then
        err "This release has no .rpm file. ${TOOL_NAME} can only install .rpm packages for now. Files in the release:"
        jq -r '.assets[] | "  " + .name' <<< "$W_RELEASE" >&2
        return 1
    fi
    if ((${#rows[@]} == 1)); then
        IFS=$'\t' read -r name size url <<< "${rows[0]}"
        info "File: ${name}"
    else
        for row in "${rows[@]}"; do
            i=$((i + 1))
            IFS=$'\t' read -r name size url <<< "$row"
            printf '  %2d) %s  (%s)\n' "$i" "$name" "$(fmt_size "$size")"
        done
        ask "File number" "1"
        if [[ ! $ANSWER =~ ^[0-9]+$ ]] || ((ANSWER < 1 || ANSWER > i)); then err "Invalid selection."; return 1; fi
        IFS=$'\t' read -r name size url <<< "${rows[ANSWER-1]}"
    fi
    W_ASSET=$name; W_ASSET_SIZE=$size; W_ASSET_URL=$url
}

norm_name() { local s=${1,,}; printf '%s' "${s//[^a-z0-9]/}"; }

# Fallback only: guess the package name from the file name, preferring an installed package that matches.
guess_rpm_pkg() {
    local file=$1 guess ng n nn matches=()
    guess=$(sed -E 's/[-_.]v?[0-9].*$//' <<< "${file%.rpm}")
    guess=${guess,,}
    if ! command -v rpm >/dev/null; then printf '%s' "$guess"; return 0; fi
    if rpm -q "$guess" >/dev/null 2>&1; then printf '%s' "$guess"; return 0; fi
    ng=$(norm_name "$guess")
    while IFS= read -r n; do
        nn=$(norm_name "$n")
        if [[ $nn == "$ng" ]]; then printf '%s' "$n"; return 0; fi                              # ente-auth vs enteauth
        if ((${#ng} >= 4)) && [[ $nn == *"$ng"* ]]; then matches+=("$n"); fi                     # localsend vs localsend_app
    done < <(rpm -qa --qf '%{NAME}\n' 2>/dev/null | sort -u)
    if ((${#matches[@]} == 1)); then printf '%s' "${matches[0]}"; else printf '%s' "$guess"; fi
}

DETECTED_PKG=""; DETECT_SURE=0
detect_rpm_pkg() {  # detect_rpm_pkg <file> <url> -> sets DETECTED_PKG; DETECT_SURE=1 when it is certain
    local n
    DETECT_SURE=1
    if n=$(remote_package_name_rpm "$2"); then DETECTED_PKG=$n; return 0; fi
    DETECTED_PKG=$(guess_rpm_pkg "$1")
    DETECT_SURE=0
    if command -v rpm >/dev/null && rpm -q "$DETECTED_PKG" >/dev/null 2>&1; then DETECT_SURE=1; fi
}

default_name_from_asset() {  # LocalSend-1.19.0-linux-x86-64.rpm -> LocalSend ; ente-auth-v4.4.27-x86_64.rpm -> Ente Auth
    local base=${1%.rpm}
    base=$(sed -E 's/[-_.]v?[0-9].*$//' <<< "$base")
    pretty_name "$base"
}

add_program() {  # add_program [url|owner/repo]
    local input=${1:-} prefix version regex name id file pkg installed status
    info "${C_BLD}Add a program${C_RST}   (source: GitHub)"
    if [[ -z $input ]]; then
        info "Enter a GitHub URL, owner/repo, or just a username to browse their repos."
        info "  e.g. https://github.com/brave/brave-browser/releases"
        ask "GitHub URL, owner/repo or username"
        input=$ANSWER
    fi
    [[ -n $input ]] || { warn "Nothing entered."; return 1; }
    SOURCE="github"
    parse_repo_input "$input" || { err "Could not understand '${input}'."; return 1; }
    if [[ -z $W_REPO ]]; then wizard_pick_user_repo "$W_USER" || return 1; fi
    info "Repository: ${W_REPO}"

    wizard_pick_release || return 1
    prefix=${W_TAGNAME%%[0-9]*}
    version=${W_TAGNAME#"$prefix"}
    if [[ -z $version ]]; then err "Tag '${W_TAGNAME}' has no version number in it; cannot track it automatically."; return 1; fi

    wizard_pick_asset || return 1
    regex=$(build_asset_regex "$W_ASSET" "$version")
    if ! jq -en --arg re "$regex" --arg n "$W_ASSET" '$n | test($re)' >/dev/null 2>&1; then
        warn "Generated pattern doesn't match the chosen file; you may need to edit it afterwards."
    fi

    # Everything below is worked out automatically; nothing here needs typing.
    name=$(default_name_from_asset "$W_ASSET")
    [[ -n $name ]] || name=$(pretty_name "${W_REPO#*/}")
    id=$(slugify "$name")
    [[ -n $id ]] || { err "Could not derive a name for this program."; return 1; }
    info
    info "Reading package details..."
    detect_rpm_pkg "$W_ASSET" "$W_ASSET_URL"
    pkg=$DETECTED_PKG
    INSTALL="rpm"; PKG=$pkg
    installed=$(get_installed_version) || installed="none"
    if [[ $installed == none ]]; then
        status="not installed"
    else
        status="installed: ${installed}, since $(get_installed_date)"
    fi
    if [[ $DETECT_SURE -eq 0 ]]; then status+="; name is a guess and will be double-checked on install"; fi

    info
    info "${C_BLD}Ready to track:${C_RST}"
    info "  Program:     ${name}   (id: ${id})"
    info "  Repository:  ${W_REPO}"
    info "  File:        ${W_ASSET}"
    info "  Package:     ${pkg}   [${status}]"
    file="${APPS_DIR}/${id}.conf"
    if [[ -f $file ]]; then warn "  Note: ${id}.conf already exists and would be replaced."; fi
    confirm_strict "Track this program?" y || { info "Cancelled."; return 1; }
    if [[ -f $file ]]; then
        confirm_strict "Replace the existing ${id}.conf?" n || { info "Cancelled."; return 1; }
    fi

    cat > "$file" <<CONF
# Added by ${TOOL_NAME} ${TOOL_VERSION} on $(date +%F)
# Read as KEY='value' data (nothing in this file is executed). No inline comments.

# Display name (shown in tables and messages; change it freely)
NAME='$(clean_value "$name")'
# Where releases come from (only "github" for now)
SOURCE='github'
# GitHub owner/repo
REPO='$(clean_value "$W_REPO")'
# Only releases whose tag starts with this are considered (separates products in shared repos)
TAG_PREFIX='$(clean_value "$prefix")'
# Regex the release file name must match
ASSET_REGEX='$(clean_value "$regex")'
# How it is installed (supported: rpm)
INSTALL='rpm'
# Package name known to rpm (check with: rpm -q <name>)
PKG='$(clean_value "$pkg")'
# Checksum policy: auto (verify when published, otherwise ask), required, or skip
VERIFY_CHECKSUM='auto'
CONF
    ok "Saved ${file}"
    STATUS_FRESH=0

    refresh_status "$id"
    info "Installed: ${ST_INSTALLED[$id]}   Latest: ${ST_LATEST[$id]} (released ${ST_RELEASED[$id]})   -> ${ST_STATE[$id]}"
    case ${ST_STATE[$id]} in
        "not installed"|"update available") update_app "$id" || true ;;
    esac
}

first_run() {
    info "No programs are being tracked yet."
    if confirm_strict "Add your first program now?" y; then add_program || true; fi
}

# ---------- manage ----------
edit_file() {
    local f=$1 ed=${VISUAL:-${EDITOR:-}} cmd=()
    if [[ -z $ed ]]; then
        for ed in nano vim vi; do
            if command -v "$ed" >/dev/null; then break; fi
            ed=""
        done
    fi
    [[ -n $ed ]] || { err "No editor found. Set \$EDITOR or \$VISUAL."; return 1; }
    read -ra cmd <<< "$ed"      # the editor may carry arguments, e.g. "code -w"
    "${cmd[@]}" "$f"
}

edit_app() {
    local id=$1
    [[ $id =~ ^[A-Za-z0-9._-]+$ && -f "${APPS_DIR}/${id}.conf" ]] || { err "Unknown program: ${id}"; return 1; }
    edit_file "${APPS_DIR}/${id}.conf" || return 1
    if ( load_app "$id" ); then ok "${id}.conf looks valid."; else warn "Fix the problem above with: ${TOOL_NAME} edit ${id}"; fi
    STATUS_FRESH=0
}

edit_settings() {
    edit_file "$SETTINGS_FILE" || return 1
    parse_conf "$SETTINGS_FILE" "DOWNLOAD_DIR CLEAR_SCREEN"
    ok "Settings reloaded."
}

remove_app() {
    local id=$1 installed
    load_app "$id" || return 1
    installed=$(get_installed_version) || installed="?"
    info "${C_BLD}${NAME}${C_RST} (${id}) — package ${PKG}, installed version: ${installed}"
    info "  1) Uninstall the program AND delete its ${TOOL_NAME} config"
    info "  2) Only delete the ${TOOL_NAME} config (stop tracking; program stays installed)"
    info "  c) Cancel"
    ask "Choice" "c"
    case $ANSWER in
        1)
            if [[ $installed == none ]]; then
                info "${PKG} is not installed; nothing to uninstall."
            else
                confirm_strict "This runs the ${INSTALL} uninstall for '${PKG}'. Continue?" n || { info "Cancelled."; return 0; }
                "uninstall_${INSTALL}" || { err "Uninstall failed; config kept."; return 1; }
            fi
            rm -f "${APPS_DIR}/${id}.conf"
            ok "Removed ${id}."
            ;;
        2)
            confirm_strict "Delete ${APPS_DIR}/${id}.conf?" n || { info "Cancelled."; return 0; }
            rm -f "${APPS_DIR}/${id}.conf"
            ok "No longer tracking ${id}."
            ;;
        *) info "Cancelled."; return 0 ;;
    esac
    STATUS_FRESH=0
}

# ---------- interactive ----------
PICKED=""
pick_app() {  # sets PICKED
    local ids=() choice
    mapfile -t ids < <(list_app_ids)
    ((${#ids[@]})) || { warn "No programs tracked yet."; return 1; }
    ask "Program number (or id)"
    choice=$ANSWER
    if [[ $choice =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= ${#ids[@]})); then
        PICKED=${ids[choice-1]}
    elif [[ $choice =~ ^[A-Za-z0-9._-]+$ && -f "${APPS_DIR}/${choice}.conf" ]]; then
        PICKED=$choice
    else
        warn "Invalid selection."; return 1
    fi
}

NOTICE=""

clear_screen() {  # honours CLEAR_SCREEN=no in the settings file
    case ${CLEAR_SCREEN,,} in no|false|off|0) return 0 ;; esac
    if [[ -t 1 ]]; then printf '\033[H\033[2J'; fi
}

after_job() {  # pause so the output can be read, then go back to the menu or quit
    local reply
    printf '\n%sPress Enter to return to the main menu, or q to quit:%s ' "$C_BLD" "$C_RST" >&2
    read -r reply || { echo >&2; exit 0; }
    if [[ $reply =~ ^[Qq] ]]; then exit 0; fi
    return 0
}

print_menu() {
    info "${C_BLD}${TOOL_NAME} ${TOOL_VERSION}${C_RST} — GitHub release updater"
    info
    info "  1) Check for updates"
    info "  2) Update one program"
    info "  3) Update all outdated"
    info "  4) List tracked programs"
    info "  5) Add a program"
    info "  6) Edit a program's config"
    info "  7) Uninstall / stop tracking a program"
    info "  8) Edit ${TOOL_NAME} settings"
    info "  q) Quit"
    info
    if [[ -n $NOTICE ]]; then warn "$NOTICE"; NOTICE=""; fi
}

interactive() {
    local none="No programs tracked yet. Use option 5 to add one."
    if ! has_apps; then clear_screen; first_run; after_job; fi
    while true; do
        clear_screen
        print_menu
        ask "Select"
        if [[ $ANSWER =~ ^[Qq]$ ]]; then exit 0; fi
        clear_screen
        case $ANSWER in
            1) if has_apps; then refresh_all; print_table; else warn "$none"; fi ;;
            2) if has_apps; then
                   ensure_status; print_table; info
                   if pick_app; then update_app "$PICKED" || true; fi
               else warn "$none"; fi ;;
            3) if has_apps; then update_all || true; else warn "$none"; fi ;;
            4) if has_apps; then print_tracked; else warn "$none"; fi ;;
            5) add_program || true ;;
            6) if has_apps; then print_tracked; info; if pick_app; then edit_app "$PICKED" || true; fi
               else warn "$none"; fi ;;
            7) if has_apps; then print_tracked; info; if pick_app; then remove_app "$PICKED" || true; fi
               else warn "$none"; fi ;;
            8) edit_settings || true ;;
            *) NOTICE="Invalid choice: ${ANSWER:-(nothing)}"; continue ;;
        esac
        after_job
    done
}

# ---------- main ----------
require_apps() {
    if ! has_apps; then
        info "No programs tracked yet. Add one with: ${TOOL_NAME} add"
        exit 0
    fi
}

main() {
    local args=() a
    for a in "$@"; do
        case $a in
            -h|--help)    usage; exit 0 ;;
            -V|--version) echo "${TOOL_NAME} ${TOOL_VERSION}"; exit 0 ;;
            -y|--yes)     ASSUME_YES=1 ;;
            *)            args+=("$a") ;;
        esac
    done
    set -- "${args[@]+"${args[@]}"}"

    case ${1:-} in
        help|list|check|config)  (($# <= 1)) || { err "Unexpected argument: $2"; exit 1; } ;;
        add|edit|remove|update)  (($# <= 2)) || { err "Unexpected argument: $3"; exit 1; } ;;
    esac

    check_deps
    init_config

    case ${1:-} in
        "")     interactive ;;
        help)   usage ;;
        add)    add_program "${2:-}" ;;
        list)   require_apps; print_tracked ;;
        check)  require_apps; refresh_all; print_table ;;
        update)
            require_apps
            case ${2:-} in
                --all) update_all ;;
                "")    err "Usage: ${TOOL_NAME} update <id> | --all"; exit 1 ;;
                *)     update_app "$2" ;;
            esac ;;
        edit)   [[ -n ${2:-} ]] || { err "Usage: ${TOOL_NAME} edit <id>"; exit 1; }; edit_app "$2" ;;
        remove) [[ -n ${2:-} ]] || { err "Usage: ${TOOL_NAME} remove <id>"; exit 1; }; remove_app "$2" ;;
        config) edit_settings ;;
        *)      err "Unknown command: $1"; echo >&2; usage >&2; exit 1 ;;
    esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    main "$@"
fi
